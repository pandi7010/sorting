# Virtual environments
.venv/
.venv*/
venv/
ENV/

# Generated by PyInstaller - rebuild with BUILD_STANDALONE_EXE.bat
build/
dist/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Temporary scratch and debug files
scratch/
*.tmp*
*.tmp

# Captured image datasets (large; back up separately)
dataset_capture/

# Runtime timing logs (Phase 2)
logs/
*.log

# Phase 6 build environment
.venv_build/

# Developer-mode unlock (developer PC only - never commit, never ship)
dev_unlock*.json

# Local backups made before changes (2 Nov 2026)
backups/

# Machine settings - each PC keeps its own (created from config_defaults/ when missing) - 4 Nov 2026
/bg_config.json
/camera_config.json
/ejector_config.json
/features_config.json
/recipes.json
/system_config.json
/wiper_config.json
/light_config.json
/vision_settings.json
